<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<OutputType>Exe</OutputType>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
	<Features Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))">
	<Compile Remove="Axent/**/*.cs" />
	<Compile Remove="Wolverine/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="Axent.Core" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
	<PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="DispatchR.Mediator" />
	<PackageReference Include="Foundatio.Mediator" />
	<PackageReference Include="Immediate.Handlers" />
	<PackageReference Include="MassTransit" />
	<PackageReference Include="Mediator.Abstractions" />
	<PackageReference Include="Mediator.SourceGenerator" PrivateAssets="All" />
	<PackageReference Include="MediatR" />
	<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
	<PackageReference Include="Microsoft.Extensions.Hosting" />
	<PackageReference Include="RhoMicro.BdnLogging" />
	<PackageReference Include="WolverineFx" Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net10.0'))" />
  </ItemGroup>

</Project>
